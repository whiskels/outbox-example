# Version tags
# https://docs.confluent.io/platform/current/installation/versions-interoperability.html
# Confluent Platform: 7.8.x = Apache Kafka: 3.8.x
CONFLUENT_PLATFORM_VERSION=7.8.2
CONDUKTOR_CONSOLE_VERSION=1.33.0
POSTGRES_VERSION=16.3
LOKI_VERSION=3.4.3
GRAFANA_VERSION=11.6.1
PROMETHEUS_VERSION=v3.3.1
TEMPO_VERSION=2.7.2
K6_VERSION=0.47.0


# Secret configuration
ORDER_SERVICE_DB_USER=order-service
ORDER_SERVICE_DB_PASSWORD=secret
LOGISTICS_SERVICE_DB_USER=logistics-service
LOGISTICS_SERVICE_DB_PASSWORD=secret
CONDUKTOR_DB_USER=conduktor
CONDUKTOR_DB_PASSWORD=secret
GRAFANA_DB_PASSWORD=secret
CONDUKTOR_ADMIN_EMAIL=admin@conduktor.io
CONDUKTOR_ADMIN_PASSWORD=adminP4ss!

# Service ports
ORDER_SERVICE_PORT=8078
LOGISTICS_SERVICE_PORT=8079
POSTGRESQL_PORT=5432
KAFKA_PORT=9092
CONDUKTOR_PORT=80
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
TEMPO_HTTP_PORT=4318
TEMPO_GRPC_PORT=4317
LOKI_PORT=3100

# Load testing configuration
LOAD_TEST_VUS=2
LOAD_TEST_DURATION=60m
