            "targets": [
                {
                    "datasource": {
                        "type": "grafana-postgresql-datasource",
                        "uid": "P1809F7CD0C75ACF4"
                    },
                    "editorMode": "code",
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT\n  date_trunc('${time_bucket}', l.created) AS time,\n  AVG(EXTRACT(EPOCH FROM (l.created - o.created)) * 1000) AS \"AVG Latency, ms\",\n  MIN(EXTRACT(EPOCH FROM (l.created - o.created)) * 1000) AS \"MIN Latency, ms\",\n  MAX(EXTRACT(EPOCH FROM (l.created - o.created)) * 1000) AS \"MAX Latency, ms\",\n  COUNT(*) AS \"Orders in sync\"\nFROM \"logistics_service\".orders l\nINNER JOIN \"order_service\".orders o\n  ON o.id = l.id\nWHERE l.created >= o.created\nGROUP BY time\nORDER BY time DESC",
                    "refId": "A",
                    "sql": {
                        "columns": [
                            {
                                "parameters": [],
                                "type": "function"
                            }
                        ],
                        "groupBy": [
                            {
                                "property": {
                                    "type": "string"
                                },
                                "type": "groupBy"
                            }
                        ],
                        "limit": 50
                    }
                }
            ],
            "title": "Order synchronization latency (per ${time_bucket})",
            "type": "timeseries"
